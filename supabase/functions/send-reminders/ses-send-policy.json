{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendVeraPhiusRemindersOnly",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:ap-southeast-2:YOUR-AWS-ACCOUNT-ID:identity/veraphius.com",
      "Condition": {
        "StringEquals": { "ses:FromAddress": "reminders@veraphius.com" }
      }
    }
  ]
}
